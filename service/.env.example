# 本地开发用（不进 Docker）：复制为 service/.env
#   cp service/.env.example service/.env

# ---- MySQL（本地需先启动 MySQL，或在根目录用 docker compose 只启动 db）----
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=nutri_agent

# ---- Agent ----
MAX_RETRIES=2

# ---- LLM ----
# mock：不调用真实模型，用于演示与测试（无需 key）
# deepseek：调用真实模型，需要填写 DEEPSEEK_API_KEY
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
LLM_TIMEOUT=150
