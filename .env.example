# 复制为 .env 后填写：cp .env.example .env
# docker compose 会自动读取项目根目录的 .env

# ---- MySQL（必填）----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=nutri
MYSQL_PASSWORD=change-me
# 改库名时要同步修改 db/init/01_schema.sql 里的库名
MYSQL_DB=nutri_agent

# ---- Agent ----
MAX_RETRIES=2

# ---- LLM ----
# 先用 mock 看演示效果（不花钱）；要接真实模型改成 deepseek 并填 key
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
LLM_TIMEOUT=150
